# Fuente (override si la STPS mueve rutas — ya pasó con /Publico)
REPSE_BASE_URL=https://repse.stps.gob.mx/

# Auth del MCP
MCP_API_KEY=            # bearer estatico; protege /connect si OAuth esta apagado

# OAuth WorkOS AuthKit (opcional)
AUTHKIT_DOMAIN=
BASE_URL=https://repse-mcp.onrender.com

# Tuning
DIAS_ALERTA=60          # dias antes del vencimiento para marcar POR_VENCER
BATCH_CONCURRENCY=4     # cortesia con el portal de la STPS
LOG_LEVEL=INFO

# Cruce SAT 69/69-B (tool verificar_proveedor)
# Centinela: el lado de listas del cruce. Sin llave funciona en carril anónimo
# (determinista, 10 consultas/min); con llave usa el carril de IA y el límite
# de la llave. La URL solo se cambia para apuntar a un despliegue propio.
CENTINELA_API_URL=https://centinela-api-op1b.onrender.com
CENTINELA_API_KEY=          # opcional: cnt_live_…
